# Copy this file and set the values as environment variables in Railway
# (Railway Dashboard → your service → Variables tab)

# Required
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=digitalworedav3-production.up.railway.app

# Cloudinary — required for persistent image/file storage on Railway
# Get these from cloudinary.com → Dashboard → API Keys
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Optional – Twilio SMS notifications
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
